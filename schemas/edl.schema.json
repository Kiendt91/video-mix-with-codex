{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kiendt91/video-mix-with-codex/schemas/edl.schema.json",
  "title": "Video Mix With Codex EDL",
  "type": "object",
  "required": ["project", "shots"],
  "oneOf": [{ "required": ["music"] }, { "required": ["audio"] }],
  "properties": {
    "project": {
      "type": "object",
      "required": ["duration", "width", "height", "fps"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "kicker": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 }
      },
      "additionalProperties": true
    },
    "music": { "$ref": "#/$defs/audioBed" },
    "audio": { "$ref": "#/$defs/audioBed" },
    "assets": {
      "type": "object",
      "properties": {
        "gsap": { "type": "string" }
      },
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "properties": {
        "flashColors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mode": {
          "type": "string",
          "enum": [
            "default",
            "anime_game_lyric",
            "captioned_explainer",
            "cinematic_character",
            "space_battle_trailer"
          ]
        }
      },
      "additionalProperties": true
    },
    "effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/effectCue" }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    },
    "dialogue": {
      "type": "array",
      "items": { "$ref": "#/$defs/dialogue" }
    },
    "captions": {
      "type": "array",
      "items": { "$ref": "#/$defs/caption" }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "intent": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "audioBed": {
      "type": "object",
      "required": ["path", "start", "duration"],
      "properties": {
        "path": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "shot": {
      "type": "object",
      "required": ["id", "source", "sourceStart", "timelineStart", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "sourceStart": { "type": "number", "minimum": 0 },
        "timelineStart": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "trackIndex": { "type": "integer", "minimum": 0 },
        "reframe": { "$ref": "#/$defs/reframe" },
        "audioRole": {
          "type": "string",
          "enum": [
            "muted_visual",
            "music_bed",
            "dialogue_line",
            "dialogue_match_visual",
            "diegetic_sfx"
          ]
        },
        "storyBeat": { "type": "string" },
        "visualRisk": { "type": "string" },
        "effects": {
          "type": "array",
          "items": {
            "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/effectCue" }]
          }
        },
        "preprocessEffects": {
          "type": "array",
          "items": {
            "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/preprocessEffect" }]
          }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "reframe": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["center", "manual", "keyframes"]
        },
        "scaleMode": {
          "type": "string",
          "enum": ["cover", "width", "height"]
        },
        "scaleWidth": { "type": "number", "minimum": 16 },
        "scaleHeight": { "type": "number", "minimum": 16 },
        "x": {
          "oneOf": [{ "type": "number" }, { "type": "string" }]
        },
        "y": {
          "oneOf": [{ "type": "number" }, { "type": "string" }]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reframeKeyframe" }
        },
        "subject": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "reframeKeyframe": {
      "type": "object",
      "required": ["t"],
      "properties": {
        "t": { "type": "number", "minimum": 0 },
        "x": {
          "oneOf": [{ "type": "number" }, { "type": "string" }]
        },
        "y": {
          "oneOf": [{ "type": "number" }, { "type": "string" }]
        },
        "subject": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "preprocessEffect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cinematic-grade",
            "cold-space-grade",
            "rgb-shift",
            "vignette-native",
            "frei0r",
            "frei0r-glow",
            "frei0r-contrast0r",
            "frei0r-saturat0r",
            "frei0r-distort0r"
          ]
        },
        "plugin": { "type": "string" },
        "shift": { "type": "integer" },
        "angle": { "type": "number" },
        "filterParams": { "type": "string" },
        "fallback": { "type": "string" },
        "require": { "type": "boolean" },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "effectCue": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "flash-through-white",
            "impact-pulse",
            "cinematic-zoom",
            "whip-zoom",
            "frame-border",
            "chromatic-radial-split",
            "vignette-swell",
            "beat-freeze",
            "anamorphic-flare",
            "hud-scan",
            "shake-hit",
            "letterbox-pulse",
            "negative-space-reset",
            "subtitle-slam",
            "hold-bloom"
          ]
        },
        "timelineStart": { "type": "number", "minimum": 0 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "target": { "type": "string" },
        "color": { "type": "string" },
        "intensity": { "type": "number", "minimum": 0 },
        "scale": { "type": "number", "minimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "note": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "dialogue": {
      "type": "object",
      "required": ["id", "source", "sourceStart", "timelineStart", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "sourceStart": { "type": "number", "minimum": 0 },
        "timelineStart": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 },
        "speaker": { "type": "string" },
        "subtitle": { "type": "string" }
      },
      "additionalProperties": true
    },
    "caption": {
      "type": "object",
      "required": ["duration"],
      "properties": {
        "id": { "type": "string" },
        "timelineStart": { "type": "number", "minimum": 0 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "text": { "type": "string" },
        "subtitle": { "type": "string" },
        "tone": {
          "type": "string",
          "enum": ["default", "soft", "alert", "impact"]
        },
        "position": {
          "type": "string",
          "enum": ["bottom", "top", "middle", "center"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
